  "config": {
    "address": "0x2007",
    "bits": {
      "FOSC": { "bits": [0, 1], "options": ["LP", "XT", "HS", "RC"] },
      "WDTE": { "bit": 2, "description": "Watchdog Timer Enable" },
      "PWRTE": { "bit": 3, "description": "Power-up Timer Enable" },
      "BOREN": { "bit": 6, "description": "Brown-out Reset Enable" },
